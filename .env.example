# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# REQUIRED. Signs the session cookie.
# ---------------------------------------------------------------------------
# This is the highest-consequence value in the project. A short or guessable
# secret lets an attacker forge a cookie claiming role=admin, which bypasses
# authentication rather than merely weakening it.
#
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# In production the application refuses to start if this is missing, shorter
# than 32 characters, or a placeholder value.
NICEGUI_STORAGE_SECRET=

# ---------------------------------------------------------------------------
# Deployment mode: development (default) or production.
# ---------------------------------------------------------------------------
# production  -> session cookies marked Secure (requires TLS), auto-reload off,
#                configuration problems become start-up failures
# development -> cookies work over plain HTTP on localhost, warnings only
#
# Leave unset for local work. Set to production when deploying.
DKA_ENV=development

# ---------------------------------------------------------------------------
# OPTIONAL. Port to serve on. Defaults to 8081.
# ---------------------------------------------------------------------------
DKA_PORT=

# ---------------------------------------------------------------------------
# OPTIONAL. Only needed to rebuild the postcode coordinate table.
# ---------------------------------------------------------------------------
# Used solely by scripts/build_plz5_coordinates.py, which is run once offline.
# The application itself never makes a network call — it reads the generated
# src/data/plz5_coordinates.csv. Free key from https://www.geoapify.com/
GEOAPIFY_API_KEY=
