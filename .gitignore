# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store

# IDE
.idea/

# NiceGUI per-user session storage
.nicegui/

# Local Claude Code settings (launch.json is shared, settings.local.json is not)
.claude/settings.local.json

# --- src/data ---------------------------------------------------------------
# Deny by default, then allow back the files the application actually opens.
#
# Two reasons for this shape rather than a list of exclusions:
#   1. src/data holds ~126 MB of raw source downloads (destatis, GISD_Bund,
#      Klinik-Atlas, de_kreise.gpkg) that no code path reads. Committing them
#      would put them in history permanently, and GitHub rejects >100 MB files.
#   2. This is where real patient data will land. Deny-by-default means a new
#      clinic extract dropped into this folder cannot be committed by accident;
#      it has to be allowlisted deliberately.
src/data/*
!src/data/GISD_PLZ5_Baden-Wuerttemberg.tsv
!src/data/landkreise_baden_wuerttemberg.geojson
!src/data/kvbw_pediatricians.csv
!src/data/bw_childrens_hospitals_2026-07-28.csv
!src/data/plz5_reference_pilot_region.csv
!src/data/plz5_coordinates.csv
!src/data/dka_synthetic_patients_plz5.csv

# The live database, including the WAL/SHM sidecars.
src/data/app.db
src/data/app.db-*

# Database backups. These contain patient data — they belong on encrypted
# storage under the same access restrictions as the live database, never in
# version control.
backups/

# Test and coverage artefacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/
junit-*.xml
.ruff_cache/
